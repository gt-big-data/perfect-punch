# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# None of these are secrets. They are baked into the site at BUILD time, so after
# changing one you must restart `npm run dev` (or rebuild for deployment).

# The part before .ciamlogin.com (Entra admin center, Overview, "Primary domain")
VITE_AZURE_TENANT_SUBDOMAIN=

# Application (client) ID of the "Perfect Punch Web" app registration
VITE_AZURE_CLIENT_ID=

# Where Microsoft sends people back after sign-in. Must be registered exactly on the
# app registration. Leave blank to use the address the site is running on.
VITE_REDIRECT_URI=http://localhost:5173

# The API scope, from the "Perfect Punch API" registration: api://<API client ID>/Game.Play
VITE_API_SCOPE=

# Address of the game API (used by the game pages; empty = demo mode)
VITE_API_BASE_URL=

VITE_AZURE_TENANT_ID=7a21432c-8cc9-4bc6-8d6e-5bd753282cd2